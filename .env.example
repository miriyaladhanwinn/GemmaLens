# GemmaLens Environment Variables
# Obtain a free Google AI Studio API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Local Ollama endpoint (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# Optional Error Monitoring (Sponsor Tool: Sentry)
SENTRY_DSN=
